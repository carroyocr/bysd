<?xml version="1.0"?>
<!--
  Campo de datos de Backyard.

  Es una aplicacion aparte de la del reloj, con su propio id: en la tienda de
  Connect IQ una app y un campo de datos son dos fichas distintas, aunque
  compartan la mitad del codigo.

  La lista de productos es la parte que envejece: cada modelo nuevo de Garmin
  hay que anadirlo a mano. Para editarla, lo comodo es abrir este archivo con
  la extension de Monkey C en VS Code, que trae el selector de dispositivos y
  siempre conoce los identificadores del SDK instalado.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="c92e053656ab4fed92bc8df3229097c3"
        type="datafield"
        name="@Strings.fieldName"
        entry="BackyardFieldApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.1.0">

        <iq:products>
            <!--
              La generacion fenix 5 de 2017 se queda en Connect IQ 3.1.6, justo
              por encima del minApiLevel de este campo de datos.
            -->
            <iq:product id="fenix5"/>
            <iq:product id="fenix5s"/>
            <iq:product id="fenix5x"/>
            <iq:product id="fenixchronos"/>
            <iq:product id="fenix5plus"/>
            <iq:product id="fenix5splus"/>
            <iq:product id="fenix5xplus"/>
            <!--
              El Forerunner 645 y el 645 Music son de la misma cosecha que el
              fenix 5 y tienen su misma pantalla: 240x240 MIP, cinco botones y
              128 KB de memoria de app. El 645 se queda en Connect IQ 3.1.6,
              como los fenix de 2017; el 645 Music llega a 3.2.3.
            -->
            <iq:product id="fr645"/>
            <iq:product id="fr645m"/>
            <iq:product id="fr745"/>
            <iq:product id="fr945"/>
            <iq:product id="fr945lte"/>
            <iq:product id="fenix6"/>
            <iq:product id="fenix6pro"/>
            <iq:product id="fenix6s"/>
            <iq:product id="fenix6spro"/>
            <iq:product id="fenix6xpro"/>
            <iq:product id="fenix7"/>
            <iq:product id="fenix7s"/>
            <iq:product id="fenix7x"/>
            <iq:product id="fenix7pro"/>
            <iq:product id="fenix7spro"/>
            <iq:product id="fenix7xpro"/>
            <iq:product id="fenix7pronowifi"/>
            <iq:product id="fenix7xpronowifi"/>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fenix8solar51mm"/>
            <iq:product id="fenix8pro47mm"/>
            <iq:product id="fenixe"/>
            <iq:product id="epix2"/>
            <iq:product id="epix2pro42mm"/>
            <iq:product id="epix2pro47mm"/>
            <iq:product id="epix2pro51mm"/>
            <iq:product id="enduro"/>
            <iq:product id="enduro3"/>
            <iq:product id="fr255"/>
            <iq:product id="fr255s"/>
            <iq:product id="fr265"/>
            <iq:product id="fr265s"/>
            <iq:product id="fr955"/>
            <iq:product id="fr965"/>
            <iq:product id="instinct2"/>
            <iq:product id="venu2"/>
            <iq:product id="venu3"/>
            <iq:product id="vivoactive4"/>
            <iq:product id="vivoactive5"/>
        </iq:products>

        <!--
          Igual que la app: ninguno. La distancia y el tiempo salen de la
          actividad que ya esta grabando, que es justamente el motivo de que
          esto sea un campo de datos y no otra pantalla.
        -->
        <iq:permissions/>

        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>spa</iq:language>
            <iq:language>fre</iq:language>
            <iq:language>deu</iq:language>
            <iq:language>ita</iq:language>
            <iq:language>por</iq:language>
        </iq:languages>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
