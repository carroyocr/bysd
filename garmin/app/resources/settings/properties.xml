<?xml version="1.0"?>
<properties>
    <!--
      Los ajustes se ponen una vez desde Garmin Connect Mobile. En el reloj no
      se pregunta nada: a las veinte horas de carrera nadie quiere teclear en
      una esfera. (La duracion, la distancia y las pantallas tambien se pueden
      tocar en la linea de salida, con el boton de menu.)

      Los valores por defecto son los de la backyard clasica: una vuelta cada
      hora, de 6.7 km. La distancia va en kilometros siempre, tenga el reloj la
      unidad que tenga, y la etiqueta del ajuste lo dice.

      Este archivo era compartido con el campo de datos; se separo cuando la
      app gano los ajustes de pantallas, que alli no significan nada. Los
      cuatro primeros deben seguir iguales en los dos proyectos; autoLapKm es
      solo de la app, porque un campo de datos no puede marcar vueltas.
    -->
    <property id="lapMinutes" type="number">60</property>
    <property id="lapDistance" type="float">6.7</property>
    <property id="corralAlert" type="boolean">true</property>
    <property id="autoLap" type="boolean">false</property>
    <property id="autoLapKm" type="boolean">false</property>
    <property id="lapOff" type="boolean">false</property>

    <!--
      Las pantallas de carrera: la posicion de cada una en el recorrido de
      arriba/abajo (1 es la primera) y el 0 como "oculta". Los empates y los
      huecos no rompen nada: RaceState ordena por posicion y a igualdad por
      este orden de fabrica.
    -->
    <property id="pageLap" type="number">1</property>
    <property id="pageMargin" type="number">2</property>
    <property id="pageData" type="number">3</property>
    <property id="pageDataLap" type="number">4</property>
    <property id="pageTotal" type="number">5</property>
    <property id="pageClock" type="number">6</property>
</properties>
