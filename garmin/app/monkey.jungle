# Configuracion de compilacion de BYSD Live (app de reloj).
#
# El codigo que tambien usa el campo de datos vive en ../shared/source, y los
# ajustes y el icono en ../shared/resources. Las traducciones no: esas tienen
# que estar aqui al lado, porque monkeyc solo mira las carpetas resources-<lang>
# hermanas del manifest.xml que compila. Las genera tools/generar_strings.py.
#
# El emblema es un mapa de bits y Connect IQ no lo escala al compilar, asi que
# hay uno por tamano. El reparto va por FAMILIA de pantalla y no por lista de
# modelos: una lista de modelos hay que tocarla con cada reloj nuevo, y mientras
# no se toca, el reloj nuevo se lleva un emblema que no le cabe. Por familia,
# un modelo que no exista todavia cae solo en el grupo que le corresponde.
#
# La regla es simple: el emblema mas grande que quepa entero.

project.manifest = manifest.xml

base.sourcePath = source;../shared/source
base.resourcePath = resources;../shared/resources

# Hasta 239 px: emblema de 196. La esfera redonda mas pequena que existe hoy
# en el SDK es de 218; no hay ninguna de 208, pese a lo que decia este archivo.
round-218x218.resourcePath = $(base.resourcePath);resources-small

# El Instinct 2 es de 176 px: no hay emblema que le quepa, ni siquiera el de
# 196. Se le da el pequeno porque es el que menos hay que encoger, y del
# encogido se encarga SplashView en el propio reloj.
semioctagon-176x176.resourcePath = $(base.resourcePath);resources-small

# De 240 a 379 px se queda el emblema base de 240, que es el de resources/.

# De 380 px en adelante: emblema de 380.
round-390x390.resourcePath = $(base.resourcePath);resources-large
round-416x416.resourcePath = $(base.resourcePath);resources-large
round-454x454.resourcePath = $(base.resourcePath);resources-large

# --- Iconos del lanzador por talla ---
# El tamano del icono (35-70 px) va por dispositivo, no por familia de
# pantalla: no correlacionan (dos relojes de 454 px piden 65 y 70). Cada regla
# incluye ademas el emblema de su familia, porque la regla de dispositivo
# reemplaza a la de pantalla. Los de 65 px (fenix847mm, fr965) usan el icono
# por defecto de shared/resources y su emblema por la familia round-454.

# 35 px (pantalla base)
vivoactive4.resourcePath = $(base.resourcePath);../shared/resources-icon35

# 40 px (pantalla base)
# 40 px (pantalla base). La generacion de 2017: el fenix 5 y el 5X son de
# 240 px, como los Plus.
fenix5.resourcePath = $(base.resourcePath);../shared/resources-icon40
fenix5x.resourcePath = $(base.resourcePath);../shared/resources-icon40
# 36 px (emblema small): el fenix 5S y el Chronos son de 218 px y piden un
# icono de 36 que no pide ningun otro reloj.
fenix5s.resourcePath = $(base.resourcePath);resources-small;../shared/resources-icon36
fenixchronos.resourcePath = $(base.resourcePath);resources-small;../shared/resources-icon36
fenix5plus.resourcePath = $(base.resourcePath);../shared/resources-icon40
fenix5splus.resourcePath = $(base.resourcePath);../shared/resources-icon40
fenix5xplus.resourcePath = $(base.resourcePath);../shared/resources-icon40
fr645.resourcePath = $(base.resourcePath);../shared/resources-icon40
fr645m.resourcePath = $(base.resourcePath);../shared/resources-icon40
fr745.resourcePath = $(base.resourcePath);../shared/resources-icon40
fr945.resourcePath = $(base.resourcePath);../shared/resources-icon40
fr945lte.resourcePath = $(base.resourcePath);../shared/resources-icon40
fenix6.resourcePath = $(base.resourcePath);../shared/resources-icon40
fenix6pro.resourcePath = $(base.resourcePath);../shared/resources-icon40
fenix6s.resourcePath = $(base.resourcePath);../shared/resources-icon40
fenix6spro.resourcePath = $(base.resourcePath);../shared/resources-icon40
fenix6xpro.resourcePath = $(base.resourcePath);../shared/resources-icon40
fenix7.resourcePath = $(base.resourcePath);../shared/resources-icon40
fenix7s.resourcePath = $(base.resourcePath);../shared/resources-icon40
fenix7x.resourcePath = $(base.resourcePath);../shared/resources-icon40
fenix7pro.resourcePath = $(base.resourcePath);../shared/resources-icon40
fenix7spro.resourcePath = $(base.resourcePath);../shared/resources-icon40
fenix7xpro.resourcePath = $(base.resourcePath);../shared/resources-icon40
fenix7pronowifi.resourcePath = $(base.resourcePath);../shared/resources-icon40
fenix7xpronowifi.resourcePath = $(base.resourcePath);../shared/resources-icon40
# 40 px (MIP): los fenix 8 Solar son de 260 y 280 px, la misma familia de
# pantalla que el fenix 7 y el 7X. El fenix 8 Pro (454 px) no lleva linea:
# su icono es de 65 px, el de shared/resources, y su emblema lo pone la familia.
fenix8solar47mm.resourcePath = $(base.resourcePath);../shared/resources-icon40
fenix8solar51mm.resourcePath = $(base.resourcePath);../shared/resources-icon40
enduro.resourcePath = $(base.resourcePath);../shared/resources-icon40
enduro3.resourcePath = $(base.resourcePath);../shared/resources-icon40
fr255.resourcePath = $(base.resourcePath);../shared/resources-icon40
fr955.resourcePath = $(base.resourcePath);../shared/resources-icon40
# 40 px (pantalla pequena: emblema small)
fr255s.resourcePath = $(base.resourcePath);resources-small;../shared/resources-icon40

# 56 px (emblema large)
vivoactive5.resourcePath = $(base.resourcePath);resources-large;../shared/resources-icon56

# 60 px (emblema large)
fenix843mm.resourcePath = $(base.resourcePath);resources-large;../shared/resources-icon60
epix2.resourcePath = $(base.resourcePath);resources-large;../shared/resources-icon60
fr265.resourcePath = $(base.resourcePath);resources-large;../shared/resources-icon60
fenixe.resourcePath = $(base.resourcePath);resources-large;../shared/resources-icon60
epix2pro42mm.resourcePath = $(base.resourcePath);resources-large;../shared/resources-icon60
epix2pro47mm.resourcePath = $(base.resourcePath);resources-large;../shared/resources-icon60
epix2pro51mm.resourcePath = $(base.resourcePath);resources-large;../shared/resources-icon60
# 60 px (pantalla base)
fr265s.resourcePath = $(base.resourcePath);../shared/resources-icon60

# 62 px (emblema small)
instinct2.resourcePath = $(base.resourcePath);resources-small;../shared/resources-icon62

# 70 px (emblema large)
venu2.resourcePath = $(base.resourcePath);resources-large;../shared/resources-icon70
venu3.resourcePath = $(base.resourcePath);resources-large;../shared/resources-icon70

